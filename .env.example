# Environment layering (Next.js resolves these in order, later wins):
#
#   .env.development   committed  — loaded by `next dev`
#   .env.production    committed  — loaded by `next build` / `next start`
#   .env.local         gitignored — your machine, overrides both
#
# In production the real values come from the host (Vercel → Project →
# Settings → Environment Variables), not from a file in the repo.
#
# Copy this to .env.local to point your dev server somewhere other than the
# local stack.

# Base URL of the rippit-api backend the UI talks to.
# NEXT_PUBLIC_* vars are inlined at build time — set this in Vercel
# (Project → Settings → Environment Variables) and redeploy to change it.
# Local dev falls back to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=

# Supabase project (Auth only — data flows through the API).
# Dashboard → Settings → API. Local stack: URL http://127.0.0.1:54421 and the
# anon key from `supabase status` (run in rippit-api/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog product analytics. Set these in Vercel and redeploy for production.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
